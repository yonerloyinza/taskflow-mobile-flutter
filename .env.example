# Entorno de ejecución: dev | staging | prod
ENVIRONMENT=dev

# URL base de la API. Backends CRUD desplegados (TaskFlow):
#   https://taskflow-api-kotlin.xprad.com
#   https://taskflow-api-springboot.xprad.com
#   https://taskflow-api-go.xprad.com
#   https://taskflow-api-fastapi.xprad.com
#   https://taskflow-api-fastify.xprad.com
#   https://taskflow-api-dotnet.xprad.com
#   https://taskflow-api-rust.xprad.com
#   https://taskflow-api-nestjs.xprad.com
#
# Para emulador Android se usa 10.0.2.2:8080 apuntando a localhost.
# En build: --dart-define=API_BASE_URL=https://taskflow-api-go.xprad.com
API_BASE_URL=https://taskflow-api-go.xprad.com