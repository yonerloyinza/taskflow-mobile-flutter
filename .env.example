# Entorno de ejecución: dev | staging | prod
ENVIRONMENT=dev

# Backends CRUD desplegados (TaskFlow) — 8 disponibles.
# Health-check en runtime: GET https://<host>/health  (status=ok, database=up),
# igual que taskflow-web-react (useBackendHealth, refetch 30s).
#   https://taskflow-api-nest.xprad.com        (NestJS)
#   https://taskflow-api-springboot.xprad.com  (Spring Boot)
#   https://taskflow-api-go.xprad.com          (Go)
#   https://taskflow-api-fastapi.xprad.com     (FastAPI)
#   https://taskflow-api-fastify.xprad.com     (Fastify)
#   https://taskflow-api-dotnet.xprad.com      (.NET)
#   https://taskflow-api-rust.xprad.com        (Rust)
#   https://taskflow-api-kotlin.xprad.com      (Kotlin)
#
# Para emulador Android se usa 10.0.2.2:8080 apuntando a localhost.
# En build: --dart-define=API_BASE_URL=https://taskflow-api-go.xprad.com
API_BASE_URL=https://taskflow-api-go.xprad.com